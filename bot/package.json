{
    "name": "discord-bot",
    "version": "1.0.0",
    "description": "Advanced Discord Bot with Music, Economy, and AI Moderation",
    "main": "dist/index.js",
    "scripts": {
        "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
        "start": "node dist/index.js",
        "dev": "nodemon src/index.ts",
        "build": "npm run clean && tsc",
        "stats:pg:generate": "prisma generate --schema prisma/stats-postgres.schema.prisma",
        "stats:migrate-staging": "ts-node src/scripts/stageStatsMigration.ts",
        "lint": "eslint . --ext .ts",
        "format": "prettier --write ."
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@discord-player/downloader": "^3.0.2",
        "@discord-player/extractor": "^7.2.0",
        "@discordjs/opus": "^0.10.0",
        "@discordjs/voice": "^0.16.1",
        "@distube/ytdl-core": "^4.16.12",
        "@google/generative-ai": "^0.1.3",
        "@prisma/client": "^5.7.0",
        "date-fns": "^4.1.0",
        "discord-api-types": "^0.38.40",
        "discord-player": "^7.2.0",
        "discord-player-youtubei": "^1.5.0",
        "discord.js": "^14.21.0",
        "dotenv": "^16.6.1",
        "ffmpeg-static": "^5.2.0",
        "genius-lyrics": "^4.4.7",
        "lavalink-client": "^2.9.7",
        "libsodium-wrappers": "^0.7.15",
        "prisma": "^5.7.0",
        "winston": "^3.11.0",
        "ytdl-core": "^4.11.5"
    },
    "devDependencies": {
        "@types/node": "^20.10.4",
        "@typescript-eslint/eslint-plugin": "^6.14.0",
        "@typescript-eslint/parser": "^6.14.0",
        "eslint": "^8.55.0",
        "nodemon": "^3.0.2",
        "prettier": "^3.1.1",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    }
}
