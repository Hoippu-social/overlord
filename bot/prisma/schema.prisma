// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id // Discord User ID
  balance   Int      @default(0)
  xp        Int      @default(0)
  level     Int      @default(1)
  lastDaily DateTime?
  lastWork  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  warnings  Warning[]
}

model Guild {
  id        String   @id // Discord Guild ID
  prefix    String   @default("!")
  name      String?
  icon      String?
  channels  String?  // JSON string of channels
  roles     String?  // JSON string of roles
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  musicConfig MusicConfig?
}

model MusicConfig {
  id              Int      @id @default(autoincrement())
  guildId         String   @unique
  guild           Guild    @relation(fields: [guildId], references: [id])
  channelMode     String   @default("BLACKLIST") // WHITELIST or BLACKLIST
  allowedChannels String?  // JSON string of channel IDs
  djMode          Boolean  @default(false)
  djRoles         String?  // JSON string of role IDs
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Warning {
  id        Int      @id @default(autoincrement())
  reason    String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  moderatorId String
  createdAt DateTime @default(now())
}
